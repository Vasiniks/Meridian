+.lu-grid{position:relative;height:100%;display:grid;
+  grid-template-columns:minmax(0,.42fr) minmax(0,.58fr);grid-template-rows:auto minmax(0,1fr) auto;
+  padding:104px var(--gut) 40px;column-gap:24px}
