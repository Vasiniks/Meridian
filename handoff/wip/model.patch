+
+
+# glTF node translations (glTF Y-up). Clip parts ride off-axis.
+GLTF_TRANSLATION_OVERRIDES = {
+    "clipBlade": [0.0, 4.85, 0.0],
+    "clipFoot": [0.0, 5.75, 0.42],
+    "clipScrew": [0.0, 5.75, 0.50],
+}
+
